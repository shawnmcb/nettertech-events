{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "includes/Services",
            "includes/Models",
            "includes/Enums",
            "includes/Repositories",
            "includes/API",
            "includes/Admin",
            "includes/Integrations/WooCommerce",
            "includes/Frontend"
        ],
        "excludes": [
            "QRImageWithLogo.php"
        ]
    },
    "bootstrap": "infection-bootstrap.php",
    "logs": {
        "text": "build/infection/infection.log",
        "summary": "build/infection/summary.log"
    },
    "tmpDir": "build/infection/tmp",
    "phpUnit": {
        "configDir": ".",
        "customPath": "vendor/bin/phpunit"
    },
    "mutators": {
        "@default": true,
        "@function_signature": false,

        // ── SQL query builder string mutations ──
        // Repository query builders construct SQL via string concatenation
        // ($where .= " AND ...", $join .= " LEFT JOIN ..."). Mutating concat
        // operands or operators is only meaningful with a real database.
        "ConcatOperandRemoval": {
            "ignore": [
                "NetterTechEvents\\Repositories\\*"
            ]
        },
        "Concat": {
            "ignore": [
                "NetterTechEvents\\Repositories\\*"
            ]
        },

        // ── Array item removal ──
        // Route registration, schema definitions, error response arrays,
        // add_action callback arrays, and Repository result mapping arrays
        // are structural wiring — untestable without integration tests.
        "ArrayItemRemoval": {
            "ignore": [
                "NetterTechEvents\\API\\*Controller::register_routes",
                "NetterTechEvents\\API\\*Controller::get_*_args",
                "NetterTechEvents\\API\\*Controller::get_*_schema",
                "NetterTechEvents\\API\\*Controller::create_item",
                "NetterTechEvents\\API\\*Controller::update_item",
                "NetterTechEvents\\API\\*Controller::delete_item",
                "NetterTechEvents\\Repositories\\*",
                "NetterTechEvents\\Services\\*::register",
                "NetterTechEvents\\Services\\OrderEmailHandler::handle_resend_email_ajax",
                "NetterTechEvents\\Services\\RsvpEmailHandler::*"
            ]
        },

        // ── Nullable constructor / form-data fallbacks / Repository defaults ──
        // Repository ?? fallbacks provide defaults for nullable DB columns;
        // swapping operands can cause infinite recursion (CategoryRepository)
        // or type errors on null propagation.
        "Coalesce": {
            "ignore": [
                "NetterTechEvents\\API\\*Controller::__construct",
                "NetterTechEvents\\Repositories\\*",
                "NetterTechEvents\\Services\\RsvpEmailHandler::*",
                "NetterTechEvents\\Services\\RevisionService::compute_diff"
            ]
        },

        // ── Logging & cache side-effect removal ──
        // DebugLogger::exception() in catch blocks and invalidate_attendee_cache()
        // before re-fetch are side effects that don't change return values.
        "MethodCallRemoval": {
            "ignore": [
                "NetterTechEvents\\API\\*Controller::create_item",
                "NetterTechEvents\\API\\*Controller::update_item",
                "NetterTechEvents\\API\\*Controller::delete_item",
                "NetterTechEvents\\API\\CheckInController::*",
                "NetterTechEvents\\API\\CheckInScanController::*",
                "NetterTechEvents\\API\\CheckInReportController::*",
                "NetterTechEvents\\API\\CheckInBaseController::*",
                "NetterTechEvents\\Services\\*EmailHandler::*",
                "NetterTechEvents\\Services\\ReminderEmailService::*"
            ]
        },

        // ── HTTP status codes, hook wiring, query LIMIT/OFFSET integers ──
        // 500→499/501, add_action priority 10→9/11, arg count 2→1/3,
        // Repository LIMIT/OFFSET values.
        "DecrementInteger": {
            "ignore": [
                "NetterTechEvents\\API\\*Controller::create_item",
                "NetterTechEvents\\API\\*Controller::update_item",
                "NetterTechEvents\\API\\*Controller::delete_item",
                "NetterTechEvents\\Repositories\\*",
                "NetterTechEvents\\Services\\*::register",
                "NetterTechEvents\\Services\\OrderEmailHandler::handle_resend_email_ajax",
                "NetterTechEvents\\Services\\RsvpEmailHandler::create_rsvp_ticket",
                "NetterTechEvents\\Services\\RevisionService::capture_pre_save_snapshot",
                "NetterTechEvents\\Services\\RevisionService::restore",
                // column_type: the `?? 0` / `: 0` occurrence-count defaults feed only
                // `$occ_count > 1`; 0, 1, and -1 all fail that test, so the mutated
                // default is never observed (the label is gated behind > 1).
                "NetterTechEvents\\Admin\\ListTables\\EventsListTable::column_type"
            ]
        },
        "IncrementInteger": {
            "ignore": [
                "NetterTechEvents\\API\\*Controller::create_item",
                "NetterTechEvents\\API\\*Controller::update_item",
                "NetterTechEvents\\API\\*Controller::delete_item",
                "NetterTechEvents\\Repositories\\*",
                "NetterTechEvents\\Services\\*::register",
                "NetterTechEvents\\Services\\OrderEmailHandler::handle_resend_email_ajax",
                "NetterTechEvents\\Services\\RsvpEmailHandler::create_rsvp_ticket",
                "NetterTechEvents\\Services\\RevisionService::capture_pre_save_snapshot",
                "NetterTechEvents\\Services\\RevisionService::restore",
                // column_type: see DecrementInteger note — same `> 1`-gated defaults.
                "NetterTechEvents\\Admin\\ListTables\\EventsListTable::column_type"
            ]
        },

        // ── Defense-in-depth type casts in Repositories ──
        // (int) casts on $wpdb results that return string-typed integers.
        // Removing them changes type but not value — defense-in-depth only.
        "CastInt": {
            "ignore": [
                "NetterTechEvents\\Repositories\\*",
                "NetterTechEvents\\Services\\RevisionService::restore",
                // column_type: (int) on the event id (an array key PHP already
                // coerces) and on the occurrence count (a DB COUNT, always integer).
                // Value-preserving for every real input.
                "NetterTechEvents\\Admin\\ListTables\\EventsListTable::column_type"
            ]
        },

        // ── sanitize_callback closures in route registration ──
        // Only invokable by WordPress REST infrastructure.
        "Ternary": {
            "ignore": [
                "NetterTechEvents\\API\\*Controller::get_*_args"
            ]
        },
        "ReturnRemoval": {
            "ignore": [
                "NetterTechEvents\\API\\*Controller::get_*_args",
                "NetterTechEvents\\Services\\OrderEmailHandler::*",
                "NetterTechEvents\\Services\\RsvpEmailHandler::*"
            ]
        },
        "FunctionCall": {
            "ignore": [
                "NetterTechEvents\\API\\*Controller::get_*_args"
            ]
        },

        // ── AJAX terminal functions & email handler side effects ──
        // check_ajax_referer, wp_send_json_*, wp_delete_file — WordPress
        // terminal/side-effect functions mocked to throw in unit tests.
        "FunctionCallRemoval": {
            "ignore": [
                "NetterTechEvents\\Services\\OrderEmailHandler::handle_resend_email_ajax",
                "NetterTechEvents\\Services\\*EmailHandler::*",
                "NetterTechEvents\\Services\\ReminderEmailService::*",
                "NetterTechEvents\\Services\\RevisionService::restore"
            ]
        },

        // ── try/catch/finally cleanup ──
        // Finally blocks for temp ICS file cleanup — removing them only
        // affects cleanup, not observable return values.
        "UnwrapFinally": {
            "ignore": [
                "NetterTechEvents\\Services\\*EmailHandler::*",
                "NetterTechEvents\\Services\\ReminderEmailService::*"
            ]
        },
        "Finally_": {
            "ignore": [
                "NetterTechEvents\\Services\\*EmailHandler::*",
                "NetterTechEvents\\Services\\ReminderEmailService::*"
            ]
        },

        // ── Logic mutations in email/RSVP flow ──
        // Email sending decisions involve wp_mail() infrastructure
        // that's mocked out in unit tests.
        "LogicalNot": {
            "ignore": [
                "NetterTechEvents\\Services\\RsvpEmailHandler::*",
                "NetterTechEvents\\Services\\OrderEmailHandler::handle_resend_email_ajax"
            ]
        },
        "LogicalAndNegation": {
            "ignore": [
                "NetterTechEvents\\Services\\*EmailHandler::*",
                "NetterTechEvents\\Services\\ReminderEmailService::*"
            ]
        },
        "LogicalAndSingleSubExprNegation": {
            "ignore": [
                "NetterTechEvents\\Services\\*EmailHandler::*",
                "NetterTechEvents\\Services\\ReminderEmailService::*"
            ]
        },
        "FalseValue": {
            "ignore": [
                "NetterTechEvents\\Services\\*EmailHandler::*",
                "NetterTechEvents\\Services\\ReminderEmailService::*"
            ]
        },
        "OneZeroFloat": {
            "ignore": [
                "NetterTechEvents\\Services\\RsvpEmailHandler::create_rsvp_ticket"
            ]
        },
        "IfNegation": {
            "ignore": [
                "NetterTechEvents\\Services\\RsvpEmailHandler::*"
            ]
        },

        // ── Loop control flow in diff computation ──
        // continue→break in compute_diff metadata skip — structural, not observable.
        "Continue_": {
            "ignore": [
                "NetterTechEvents\\Services\\RevisionService::compute_diff"
            ]
        },

        // ── MBString in RevisionRepository ──
        // mb_substr→substr for change_summary truncation — defense-in-depth
        // for multibyte safety, functionally equivalent for ASCII.
        "MBString": {
            "ignore": [
                "NetterTechEvents\\Repositories\\RevisionRepository::insert"
            ]
        }
    },
    // Lowered from 75% after expanding scope to includes/API (GAP-010).
    // API controller sanitize/validate callbacks are closures inside register_routes(),
    // only invokable by WordPress REST infrastructure — untestable at unit level.
    // Backlog: extract callbacks to named methods, then raise back to 75%.
    // Raised from 70% to 80% per Phase 12 target.
    // Expanded scope: includes/Admin, includes/Integrations/WooCommerce, includes/Frontend.
    "minMsi": 80,
    "minCoveredMsi": 80,
    "testFramework": "phpunit",
    "timeout": 10
}
