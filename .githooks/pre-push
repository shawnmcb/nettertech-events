#!/bin/bash
# Pre-push hook: thorough checks that run before pushing.
# Install: composer hook:install
# Bypass:  git push --no-verify
#
# ADR-017: Layer 2 validation — heavier checks not in pre-commit.

set -e
PLUGIN_DIR="$(git rev-parse --show-toplevel)"
cd "$PLUGIN_DIR"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
FAILED=0

LOCK_FILE="/tmp/ve-infection-$(echo "$PLUGIN_DIR" | md5 -q).lock"
COVERAGE_TMP=$(mktemp)
trap "rm -f $LOCK_FILE $COVERAGE_TMP" EXIT

echo ""
echo "Running pre-push checks..."
echo ""

# ============================================================================
# Check 0.5: Frontend static gate (T4.1.4 — QG-05/ENH-04)
# Suite plan T4.1.4 fan-out from Migrator pilot. Wraps wp-scripts lint-js
# with the 5-rule catalog from audit/suite/frontend/FRONTEND-GATE-RULES.md.
# Gate fails on ANY new violation; pre-existing grandfathered via file-level
# disables per audit/suite/frontend/EVENTS-FRONTEND-GATE-BASELINE.md.
# ============================================================================
if [ -d "node_modules" ]; then
    echo "Running frontend static gate (lint:js)..."
    if ! composer lint:js --quiet 2>/dev/null; then
        echo -e "${RED}Frontend gate failed${NC} — run 'composer lint:js' for details"
        echo -e "${YELLOW}See audit/suite/frontend/FRONTEND-GATE-RULES.md for rule catalog${NC}"
        FAILED=1
    else
        echo -e "${GREEN}Frontend gate passed${NC}"
    fi
else
    echo -e "${YELLOW}Frontend gate not configured (no node_modules) — skipping${NC}"
fi
echo ""

# ============================================================================
# Check 0.6: Bootstrap smoke (T5.1.8 — QG-10)
# Phase 5 / T5.1. Verifies the plugin wakes up correctly in a real WP runtime:
# class loaded, ServiceRegistry resolves, schema tables exist, hooks attached.
# See audit/suite/patterns/BOOTSTRAP-SMOKE-PATTERN.md for the convention.
# Memory limit raised to 512M — Kadence Blocks + theme.json processing can
# exhaust the default 128M during PHPUnit's WordPress shutdown phase.
# ============================================================================
if [ -f "phpunit-integration.xml.dist" ] || [ -f "phpunit-integration.xml" ]; then
    echo "Running bootstrap smoke tests..."
    if ! php -d memory_limit=512M vendor/bin/phpunit \
        --configuration phpunit-integration.xml.dist \
        --group bootstrap-smoke \
        --no-coverage 2>&1; then
        echo -e "${RED}Bootstrap smoke failed${NC} — run 'composer test:integration -- --group bootstrap-smoke' for details"
        FAILED=1
    else
        echo -e "${GREEN}Bootstrap smoke passed${NC}"
    fi
else
    echo -e "${YELLOW}Bootstrap smoke not configured (no phpunit-integration.xml.dist) — skipping${NC}"
fi
echo ""

# ============================================================================
# Check 1: Infection (mutation testing) — skip if not configured
# ============================================================================
if [ -f "infection.json5" ] || [ -f "infection.json" ]; then
    if [ ! -x "vendor/bin/infection" ]; then
        echo -e "${YELLOW}Infection config found but binary not installed — skipping${NC}"
    else
        # Guard: abort if another Infection run is active for this plugin.
        if [ -f "$LOCK_FILE" ]; then
            LOCK_PID=$(cat "$LOCK_FILE" 2>/dev/null)
            if [ -n "$LOCK_PID" ] && kill -0 "$LOCK_PID" 2>/dev/null; then
                echo -e "${RED}Another Infection run is active (PID $LOCK_PID). Aborting.${NC}"
                echo "If stale, remove lock: rm $LOCK_FILE"
                exit 1
            else
                echo -e "${YELLOW}Removing stale lock (PID $LOCK_PID no longer running)${NC}"
                rm -f "$LOCK_FILE"
            fi
        fi

        echo $$ > "$LOCK_FILE"

        # INV-M1 guard: Infection can exit 0 without doing any work (observed
        # 2026-07-05: a bare `exit` in an ABSPATH guard killed mutant generation
        # with status 0 — no mutants, no logs, gate read it as a pass). Require
        # a summary.log freshly written by THIS run with a nonzero mutant total.
        verify_infection_ran() {
            local run_start="$1"
            local summary="build/infection/summary.log"
            local mtime total
            if [ ! -f "$summary" ]; then
                echo "missing"
                return
            fi
            mtime=$(stat -f %m "$summary" 2>/dev/null || stat -c %Y "$summary" 2>/dev/null || echo 0)
            if [ "$mtime" -lt "$run_start" ]; then
                echo "stale"
                return
            fi
            total=$(awk -F': ' '/^Total:/ {print $2; exit}' "$summary" | tr -d ' ')
            if [ -z "$total" ] || [ "$total" = "0" ]; then
                echo "empty"
                return
            fi
            echo "$total"
        }

        # Incremental mode: only mutate files changed vs origin/main.
        # Falls back to full run if no remote tracking branch exists.
        DIFF_BASE="origin/main"
        if git rev-parse --verify "$DIFF_BASE" >/dev/null 2>&1; then
            CHANGED_SOURCE=$(git diff --name-only "$DIFF_BASE"...HEAD -- includes/Services includes/Models includes/Enums 2>/dev/null | wc -l | tr -d ' ')
            if [ "$CHANGED_SOURCE" = "0" ]; then
                echo -e "${GREEN}No source changes in Infection scope — skipping mutation testing${NC}"
            else
                echo "Running incremental mutation testing ($CHANGED_SOURCE changed file(s))..."
                INFECTION_START=$(date +%s)
                if ! php -d memory_limit=512M vendor/bin/infection --threads=4 \
                    --git-diff-filter=AM \
                    --git-diff-base="$DIFF_BASE" \
                    --only-covering-test-cases \
                    --map-source-class-to-test 2>&1; then
                    echo -e "${RED}Infection failed — mutation score below threshold${NC}"
                    FAILED=1
                else
                    MUTANT_TOTAL=$(verify_infection_ran "$INFECTION_START")
                    case "$MUTANT_TOTAL" in
                        missing|stale|empty)
                            echo -e "${RED}Infection exited 0 but generated no mutants (summary.log: $MUTANT_TOTAL) — vacuous pass refused${NC}"
                            echo -e "${YELLOW}Likely causes: changed source has no covering tests; coverage driver inactive; a bare 'exit' killed generation (see infection-bootstrap.php ABSPATH note)${NC}"
                            FAILED=1
                            ;;
                        *)
                            echo -e "${GREEN}Infection passed (incremental, $MUTANT_TOTAL mutants)${NC}"
                            ;;
                    esac
                fi
            fi
        else
            echo "Running full mutation testing (no remote tracking branch)..."
            INFECTION_START=$(date +%s)
            if ! php -d memory_limit=512M vendor/bin/infection --threads=4 2>&1; then
                echo -e "${RED}Infection failed — mutation score below threshold${NC}"
                FAILED=1
            else
                MUTANT_TOTAL=$(verify_infection_ran "$INFECTION_START")
                case "$MUTANT_TOTAL" in
                    missing|stale|empty)
                        echo -e "${RED}Infection exited 0 but generated no mutants (summary.log: $MUTANT_TOTAL) — vacuous pass refused${NC}"
                        echo -e "${YELLOW}Likely causes: coverage driver inactive; a bare 'exit' killed generation (see infection-bootstrap.php ABSPATH note)${NC}"
                        FAILED=1
                        ;;
                    *)
                        echo -e "${GREEN}Infection passed (full, $MUTANT_TOTAL mutants)${NC}"
                        ;;
                esac
            fi
        fi
    fi
else
    echo -e "${YELLOW}Infection not configured — skipping${NC}"
fi

echo ""

# ============================================================================
# Check 2: Coverage threshold enforcement (ADR-017 Layer 2)
# ============================================================================
# Threshold set to 72% as a 1% safety buffer below the measured baseline
# of 73.01% (PCOV, 2026-04-12). The original aspirational target was 75%
# but was set before coverage was actually measured. The path back to 75%+
# is tracked in the improvement backlog (item B-3).
THRESHOLD=72
echo "Checking coverage threshold (minimum ${THRESHOLD}%)..."

php vendor/bin/phpunit --coverage-text --colors=never > "$COVERAGE_TMP" 2>&1
PHPUNIT_EXIT=$?

if [ "$PHPUNIT_EXIT" -ne 0 ]; then
    echo -e "${RED}PHPUnit coverage run failed (exit code $PHPUNIT_EXIT)${NC}"
    FAILED=1
else
    LINE_COVERAGE=$(grep -m1 'Lines:' "$COVERAGE_TMP" | grep -o '[0-9]*\.[0-9]*' | head -1)

    if [ -z "$LINE_COVERAGE" ]; then
        echo -e "${RED}Could not parse line coverage from PHPUnit output — failing safe${NC}"
        FAILED=1
    else
        PASS=$(echo "$LINE_COVERAGE >= $THRESHOLD" | bc -l 2>/dev/null || echo "0")
        if [ "$PASS" -eq 0 ]; then
            echo -e "${RED}Coverage ${LINE_COVERAGE}% is below threshold ${THRESHOLD}%${NC}"
            FAILED=1
        else
            echo -e "${GREEN}Coverage ${LINE_COVERAGE}% (threshold: ${THRESHOLD}%)${NC}"
        fi
    fi
fi

echo ""

# ============================================================================
# Secrets scan (INV-S3 — .coherence-invariants.md)
# Scans outgoing commits only. Hard gate: a silently-skipping security gate
# is the anti-pattern INV-M1 exists to prevent, so a missing gitleaks binary
# fails the push with install instructions rather than warning and passing.
# ============================================================================
echo "Scanning outgoing commits for secrets (gitleaks)..."
if ! command -v gitleaks >/dev/null 2>&1; then
    echo -e "${RED}gitleaks not found — install with: brew install gitleaks${NC}"
    FAILED=1
else
    RANGE_OPT=""
    if git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
        RANGE_OPT="--log-opts=@{u}..HEAD"
    fi
    if gitleaks git --no-banner --redact ${RANGE_OPT:+"$RANGE_OPT"} . >/dev/null 2>&1; then
        echo -e "${GREEN}No secrets detected in outgoing commits${NC}"
    else
        echo -e "${RED}gitleaks found potential secrets — run 'gitleaks git --log-opts=@{u}..HEAD' for detail${NC}"
        FAILED=1
    fi
fi

echo ""

# ============================================================================
# Final result
# ============================================================================
if [ "$FAILED" -eq 1 ]; then
    echo -e "${RED}Pre-push checks failed.${NC} Fix issues or bypass with: git push --no-verify"
    exit 1
fi

echo -e "${GREEN}All pre-push checks passed.${NC}"
