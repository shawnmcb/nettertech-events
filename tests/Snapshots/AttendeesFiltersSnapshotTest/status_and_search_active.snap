<form method="get" class="nte-attendees-filters">
<input type="hidden" name="page" value="nettertech-events-attendees">
<div class="nte-filter-group">
<label for="occurrence_id">Event</label>
<select name="occurrence_id" id="occurrence_id">
<option value="">All Events</option>
</select>
</div>
<div class="nte-filter-group">
<label for="status">Status</label>
<select name="status" id="status">
<option value="">All Statuses</option>
<option value="confirmed"
selected="selected">
Confirmed </option>
<option value="pending"
>
Pending </option>
<option value="cancelled"
>
Cancelled </option>
<option value="refunded"
>
Refunded </option>
<option value="voided"
>
Voided </option>
</select>
</div>
<div class="nte-filter-group">
<label for="placeholder">Data Quality</label>
<select name="placeholder" id="placeholder">
<option value="">All Attendees</option>
<option value="no"
>
Real Data Only </option>
<option value="yes"
>
Placeholder Data </option>
</select>
</div>
<div class="nte-filter-group">
<label for="s">Search</label>
<input type="search" name="s" id="s" value="jane"
placeholder="Name or email...">
</div>
<div class="nte-filter-actions">
<button type="submit" class="button button-primary">Filter</button>
<a href="http://example.test/wp-admin/admin.php?page=nettertech-events-attendees" class="button">
Clear </a>
</div>
</form>