<div class="nte-event-qr-logo-section" style="margin: 12px 0; padding-top: 10px; border-top: 1px solid #ddd;">
<p style="margin: 0 0 8px 0; text-align: center; font-size: 12px; color: #646970;">
<strong>Logo</strong>
</p>
<div class="nte-event-qr-logo-options" role="radiogroup" aria-label="QR Code Logo" style="display: flex; flex-wrap: wrap; gap: 6px; justify-content: center;">
<!-- Use Default -->
<label class="nte-event-qr-logo-opt nte-event-qr-logo-opt--selected" data-mode="default" tabindex="0" role="radio" aria-checked="true">
<input type="hidden" name="_nettertech_events_qr_logo_mode" value="default" id="nte-event-qr-logo-mode">
<input type="radio" name="nte-event-qr-logo-select" value="default" checked="checked">
<span class="dashicons dashicons-admin-settings"></span>
<span class="nte-event-qr-logo-opt__text">Default</span>
</label>
<!-- No Logo -->
<label class="nte-event-qr-logo-opt" data-mode="none" tabindex="0" role="radio" aria-checked="false">
<input type="radio" name="nte-event-qr-logo-select" value="none" >
<span class="dashicons dashicons-no"></span>
<span class="nte-event-qr-logo-opt__text">None</span>
</label>
<!-- Site Logo -->
<label class="nte-event-qr-logo-opt nte-event-qr-logo-opt--disabled" data-mode="site" tabindex="0" role="radio" aria-checked="false" aria-disabled="true">
<input type="radio" name="nte-event-qr-logo-select" value="site" disabled="disabled">
<span class="dashicons dashicons-format-image"></span>
<span class="nte-event-qr-logo-opt__text">Site</span>
</label>
<!-- Custom Logo -->
<label class="nte-event-qr-logo-opt" data-mode="custom" tabindex="0" role="radio" aria-checked="false">
<input type="radio" name="nte-event-qr-logo-select" value="custom" >
<span id="nte-event-qr-custom-thumb" style="display: inline-flex; width: 20px; height: 20px; align-items: center; justify-content: center;">
<span class="dashicons dashicons-plus-alt2" style="font-size: 16px; width: 16px; height: 16px;"></span>
</span>
<span class="nte-event-qr-logo-opt__text">Custom</span>
</label>
</div>
<input type="hidden" name="_nettertech_events_qr_logo_id" value="0" id="nte-event-qr-logo-id">
<p style="margin: 6px 0 0 0; text-align: center; font-size: 11px; color: #888;">
Default: <span id="nte-event-qr-default-desc">No Logo</span> </p>
</div>