<div class="postbox">
<div class="postbox-header">
<h2>Venue</h2>
</div>
<div class="inside">
<p>
<label for="venue_name"><strong>Venue Name:</strong></label>
<input type="text" name="venue_name" id="venue_name"
value=""
class="widefat">
</p>
<p>
<label for="venue_address"><strong>Address:</strong></label>
<textarea name="venue_address" id="venue_address" rows="3" class="widefat"></textarea>
</p>
</div>
</div>