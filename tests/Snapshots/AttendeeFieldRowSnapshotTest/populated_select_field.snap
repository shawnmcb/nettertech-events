<div class="nte-attendee-field-row" style="border: 1px solid #ddd; padding: 12px; margin-bottom: 8px; background: #fafafa;">
<input type="hidden" name="attendee_fields[1][id]"
value="42">
<div style="display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;">
<div style="flex: 2; min-width: 150px;">
<label class="screen-reader-text">Label</label>
<input type="text" name="attendee_fields[1][label]"
value="T-Shirt Size"
placeholder="Field label"
class="widefat" required>
</div>
<div style="flex: 1; min-width: 120px;">
<label class="screen-reader-text">Type</label>
<select name="attendee_fields[1][field_type]" class="widefat nte-field-type-select">
<option value="text"
>
Text </option>
<option value="textarea"
>
Textarea </option>
<option value="select"
selected="selected">
Dropdown </option>
<option value="checkbox"
>
Checkbox </option>
<option value="radio"
>
Radio Buttons </option>
<option value="email"
>
Email </option>
<option value="phone"
>
Phone </option>
<option value="number"
>
Number </option>
<option value="date"
>
Date </option>
<option value="url"
>
URL </option>
</select>
</div>
<div style="flex: 0 0 auto; display: flex; align-items: center; gap: 12px;">
<label>
<input type="checkbox" name="attendee_fields[1][is_required]" value="1"
checked="checked">
Required </label>
<button type="button" class="button-link nte-remove-field" style="color: #b32d2e;">
Remove </button>
</div>
</div>
<div class="nte-field-options-wrap" style="">
<label class="screen-reader-text">Options</label>
<textarea name="attendee_fields[1][options]"
class="widefat" rows="3"
placeholder="One option per line"
>Small
Medium
Large</textarea>
<p class="description">Enter each option on a new line.</p>
</div>
<div style="display: flex; gap: 8px; margin-top: 8px;">
<div style="flex: 1;">
<input type="text" name="attendee_fields[1][placeholder]"
value="Pick a size"
placeholder="Placeholder text (optional)"
class="widefat">
</div>
</div>
</div>